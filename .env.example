# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_GROUP_ID=your_telegram_group_id_here

# Vision (OpenAI-compatible). Command Code Provider API or OpenRouter.
# Command Code: https://api.commandcode.ai/provider/v1/chat/completions
# OpenRouter:   https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=your_vision_api_key_here
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_BASE_URL=https://api.commandcode.ai/provider/v1/chat/completions

# India Post IT 2.0 Portal Credentials
IT20_USERNAME=your_employee_id
IT20_PASSWORD=your_password
IT20_BASE_URL=https://app.indiapost.gov.in/employeeportal/home
IT20_TRACK_URL=https://app.indiapost.gov.in/tracking/track/article
IT20_OTP_TIMEOUT_SEC=180
